# Copy to .env.local for local overrides (gitignored). In production, set
# this as a build-time environment variable in Netlify's dashboard instead -
# Vite bakes it into the build, it isn't read at runtime.

# Full URL of the deployed backend, no trailing slash, e.g.
# https://mysuru-homes-api.onrender.com
# Leave unset for local dev - requests then go to relative paths, which
# Vite's dev server proxies to localhost:8080 (see vite.config.js).
VITE_API_URL=
