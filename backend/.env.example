# Copy this file to .env and fill in real values. Never commit .env.
# (This project loads these as OS environment variables, not from a .env
# file directly - see the Windows setup steps for how to set them.)

DB_HOST=localhost
DB_PORT=3306
DB_NAME=real_estate
DB_USER=realestate_app
DB_PASSWORD=replace-with-your-own-strong-password

# Any long random string works. Generate one yourself, e.g. in PowerShell:
#   -join ((48..57)+(65..90)+(97..122)|Get-Random -Count 48|%{[char]$_})
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Comma-separated list of origins allowed to call this API from a browser.
# In production this must be your Netlify URL - the app doesn't ship a
# default that includes it.
ALLOWED_ORIGINS=http://localhost:5173

# The ONLY way an admin account is created (see DemoDataSeeder) - there is no
# hardcoded admin password. Leave both unset and no admin account is created.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-your-own-strong-password

# Optional: a demo OWNER/TENANT account (with a couple of sample listings for
# the owner), useful for showing the app off. Each is only created if its own
# email+password are both set - leave a pair unset to skip that account.
DEMO_OWNER_EMAIL=
DEMO_OWNER_PASSWORD=
DEMO_TENANT_EMAIL=
DEMO_TENANT_PASSWORD=

# Optional: route uploaded listing photos to Cloudinary's free tier instead of
# local disk, so they survive a restart/redeploy on a host with ephemeral disk
# (e.g. Render's free tier). Leave both unset to keep using local disk (fine
# for local dev). See DEPLOY.md for how to get these from Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
